NODE_ENV=development
LOG_LEVEL=info

# Required: BNB Smart Chain Testnet RPC access (read-only in Phase 1)
BSC_TESTNET_RPC_URL=
# Optional failover endpoint. RPC URLs may contain credentials; never commit .env.
BSC_TESTNET_RPC_URL_SECONDARY=
BSC_TESTNET_CHAIN_ID=97
RPC_TIMEOUT_MS=10000

# Fixed BSC Testnet contracts
AURIX_REWARD_CONTRACT_ADDRESS=0x355D58c905f42F4f78abCD7413371F6EE4Dba137
IRB_TEST_TOKEN_ADDRESS=0x7daf7fE962B123A6698D5e3a109c551872790AeA

# Optional in Phase 1. Set DB_HOST, DB_NAME, and DB_USER together.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Phase 2 test User Wallet encryption. Keep the key secret and never commit .env.
# Exact format: canonical Base64 encoding of 32 cryptographically random bytes.
WALLET_ENCRYPTION_KEY=
WALLET_ENCRYPTION_KEY_VERSION=1

# Phase 3 dedicated BSC Testnet Funding Wallet. Keep the private key secret.
TESTNET_FUNDING_PRIVATE_KEY=
# Optional assertion; the runtime address is always derived from the private key.
TESTNET_FUNDING_ADDRESS=
# Required explicit target for funding plan/execution; no operational default.
TEST_WALLET_TARGET_TBNB=
# Optional maximum observed gas price guard.
MAX_FUNDING_GAS_PRICE_GWEI=
# Owner-reviewed execution must explicitly override this in the untracked environment.
FUNDING_EXECUTION_ENABLED=false

# Phase 4A off-chain RewardAuthorization signer. Never commit a real key.
APPROVER_PRIVATE_KEY=
# Optional assertion; if set it must equal the fixed BSC Testnet Approver.
APPROVER_ADDRESS=
# Required explicit EIP-712 authorization lifetime in Unix seconds; no default.
AUTHORIZATION_VALIDITY_SECONDS=
