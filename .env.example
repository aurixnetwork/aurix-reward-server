NODE_ENV=development
LOG_LEVEL=info
NETWORK_PROFILE=TESTNET

# Required: BNB Smart Chain Testnet RPC access (read-only in Phase 1)
BSC_TESTNET_RPC_URL=
# Optional failover endpoint. RPC URLs may contain credentials; never commit .env.
BSC_TESTNET_RPC_URL_SECONDARY=
BSC_TESTNET_CHAIN_ID=97
RPC_TIMEOUT_MS=10000

# Fixed BSC Testnet contracts
AURIX_REWARD_CONTRACT_ADDRESS=0x355D58c905f42F4f78abCD7413371F6EE4Dba137
IRB_TEST_TOKEN_ADDRESS=0x7daf7fE962B123A6698D5e3a109c551872790AeA

# Optional in Phase 1. Set DB_HOST, DB_NAME, and DB_USER together.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Phase 2 test User Wallet encryption. Keep the key secret and never commit .env.
# Exact format: canonical Base64 encoding of 32 cryptographically random bytes.
WALLET_ENCRYPTION_KEY=
WALLET_ENCRYPTION_KEY_VERSION=1

# Phase 3 dedicated BSC Testnet Funding Wallet. Keep the private key secret.
TESTNET_FUNDING_PRIVATE_KEY=
# Optional assertion; the runtime address is always derived from the private key.
TESTNET_FUNDING_ADDRESS=
# Required explicit target for funding plan/execution; no operational default.
TEST_WALLET_TARGET_TBNB=
# Optional maximum observed gas price guard.
MAX_FUNDING_GAS_PRICE_GWEI=
# Owner-reviewed execution must explicitly override this in the untracked environment.
FUNDING_EXECUTION_ENABLED=false

# Phase 4B-2 owner-gated Test Campaign execution. Reuses the Funding key as Admin.
# Keep both additional existing-wallet keys secret; never commit a populated .env.
OPERATIONS_PRIVATE_KEY=
OPERATIONS_ADDRESS=0x9B2fB8ED115242477C9a8Ea511a0D85E122E1FbE
IRB_TOKEN_OWNER_PRIVATE_KEY=
IRB_TOKEN_OWNER_ADDRESS=0xD0801a18cF74893B12849A6f2E7b4E469b5FFc89
# Optional maximum observed gas price guard for all three campaign operations.
MAX_CAMPAIGN_GAS_PRICE_GWEI=
# Owner-reviewed execution must explicitly override this independently of funding.
CAMPAIGN_EXECUTION_ENABLED=false

# Phase 4A off-chain RewardAuthorization signer. Never commit a real key.
APPROVER_PRIVATE_KEY=
# Optional assertion; if set it must equal the fixed BSC Testnet Approver.
APPROVER_ADDRESS=
# Required explicit EIP-712 authorization lifetime in Unix seconds; no default.
AUTHORIZATION_VALIDITY_SECONDS=

# Phase 5 claimant-funded reward execution. Planning/status are always read-only.
# Optional maximum observed gas price guard and fixed 20% estimate safety margin.
MAX_CLAIM_GAS_PRICE_GWEI=
# Owner-reviewed execution must explicitly override this independently of all other guards.
CLAIM_EXECUTION_ENABLED=false

# Mainnet is a separate, fail-closed profile. The Reward Contract remains blank
# until the frozen contract is deployed and owner-reviewed.
BSC_MAINNET_RPC_URL=
BSC_MAINNET_RPC_URL_SECONDARY=
BSC_MAINNET_CHAIN_ID=56
AURX_MAINNET_TOKEN_ADDRESS=0x24ECb00840081D56116fC6D076988411a5595fd0
MAINNET_REWARD_CONTRACT_ADDRESS=
MAINNET_EXECUTION_ENABLED=false

# Mainnet Production v1 rejects any global concurrency other than one.
GLOBAL_REWARD_CONCURRENCY=1
DISPATCHER_LEASE_SECONDS=120
WALLET_LEASE_SECONDS=120

# Finite owner-reviewed safety ceilings; no effectively-unlimited defaults.
MAX_WALLETS_PER_RUN=100
MAX_TRANSACTIONS_PER_RUN=100
MAX_REWARD_PER_WALLET_AURX=1
MAX_AGGREGATE_REWARD_PER_RUN_AURX=100
# Required for read-only per-Wallet gas-capacity readiness; owner-reviewed estimate.
ESTIMATED_CLAIM_GAS=
