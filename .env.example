NODE_ENV=development
LOG_LEVEL=info

# Required: BNB Smart Chain Testnet RPC access (read-only in Phase 1)
BSC_TESTNET_RPC_URL=
# Optional failover endpoint. RPC URLs may contain credentials; never commit .env.
BSC_TESTNET_RPC_URL_SECONDARY=
BSC_TESTNET_CHAIN_ID=97
RPC_TIMEOUT_MS=10000

# Fixed BSC Testnet contracts
AURIX_REWARD_CONTRACT_ADDRESS=0x355D58c905f42F4f78abCD7413371F6EE4Dba137
IRB_TEST_TOKEN_ADDRESS=0x7daf7fE962B123A6698D5e3a109c551872790AeA

# Optional in Phase 1. Set DB_HOST, DB_NAME, and DB_USER together.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Phase 2 test User Wallet encryption. Keep the key secret and never commit .env.
# Exact format: canonical Base64 encoding of 32 cryptographically random bytes.
WALLET_ENCRYPTION_KEY=
WALLET_ENCRYPTION_KEY_VERSION=1
