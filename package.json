{
  "name": "@aurixnetwork/reward-server",
  "version": "0.1.0",
  "private": true,
  "description": "Aurix Network reward authorization and claim execution server",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:secrets": "secretlint \"**/*\"",
    "test": "vitest run",
    "preflight:testnet": "tsx src/cli/preflight.ts",
    "health:testnet": "tsx src/cli/health.ts",
    "inspect:reward:testnet": "tsx src/cli/inspect-reward-contract.ts",
    "inspect:irb:testnet": "tsx src/cli/inspect-irb-token.ts",
    "db:migrate": "tsx src/cli/migrate-database.ts",
    "wallets:create:test": "tsx src/cli/create-test-wallets.ts",
    "wallets:list:test": "tsx src/cli/list-test-wallets.ts",
    "wallets:validate:test": "tsx src/cli/validate-test-wallets.ts",
    "funding:plan:test": "tsx src/cli/plan-funding.ts",
    "funding:execute:test": "tsx src/cli/execute-funding.ts",
    "funding:status:test": "tsx src/cli/funding-status.ts",
    "campaign:inspect:test": "tsx src/cli/inspect-campaign.ts",
    "campaign:plan:create:test": "tsx src/cli/plan-campaign-creation.ts",
    "campaign:execute:preflight:test": "tsx src/cli/preflight-campaign-execution.ts",
    "campaign:execute:test": "tsx src/cli/execute-test-campaign.ts",
    "campaign:status:test": "tsx src/cli/campaign-status.ts",
    "authorization:plan:test": "tsx src/cli/plan-authorization.ts",
    "authorization:create:test": "tsx src/cli/create-authorization.ts",
    "authorization:verify:test": "tsx src/cli/verify-authorization.ts",
    "claim:plan:test": "tsx src/cli/plan-claim.ts",
    "claim:execute:test": "tsx src/cli/execute-claim.ts",
    "claim:status:test": "tsx src/cli/claim-status.ts",
    "claim:reconcile:test": "tsx src/cli/reconcile-claim.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "mysql2": "3.23.3",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "secretlint": "13.0.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
